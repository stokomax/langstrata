# Required: LLM provider API keys (at minimum, the one matching your model)
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# LLM model for all agents (supervisor + workers).
# Default from config.py: anthropic:claude-sonnet-5
AGENT_SERVER_MODEL=anthropic:claude-sonnet-4-6

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langstrata

# ── A2A completion notifier (langshark-bites) ─────────────────────────
# Enable on BOTH servers to turn the push loop on (supervisor dispatch
# shim + mailbox drain, and worker emitter middleware).
A2A_COMPLETION_NOTIFIER_ENABLED=true

# Receiver posture.  `dev` needs no signing keys; `verify`/`strict` do.
A2A_VERIFY_MODE=dev
A2A_CALLBACK_TOKEN_SECRET=change-me-callback-token-secret-0123456789

# Default packaging: receiver is embedded on the supervisor Agent Server
# (langgraph.json http.app → langstrata.a2a.webapp).  Both URLs are the
# supervisor origin; the bite appends /a2a/notifications to A2A_RECEIVER_URL.
A2A_RECEIVER_URL=http://localhost:2024
A2A_SUPERVISOR_URL=http://localhost:2024

# Sidecar / MCP bridge only (when not using embedded http.app):
# A2A_RECEIVER_PORT=8001
# A2A_RECEIVER_HOST=0.0.0.0

# Optional MCP diagnostic bridge (tools on the supervisor).  Default: off —
# webhook does not need it.  Run `just a2a-mcp-receiver-http` and set
# A2A_SUPERVISOR_MCP_URL to attach the four diagnostic tools.
A2A_MCP_TRANSPORT=stdio
# A2A_SUPERVISOR_MCP_URL=http://localhost:8001/mcp

# Optional: Redis backing for the receiver — cross-replica jti dedup
# (RedisJtiStore) + the dead-letter queue.  Omit for single-replica dev.
# A2A_REDIS_URL=redis://localhost:6379/0

# Emitter signing key — only for A2A_VERIFY_MODE=verify|strict.
# Generate with `just a2a-keys`:
# A2A_PRIVATE_KEY_FILE=.a2a-keys/worker-private.pem
# A2A_KID=worker-1
# A2A_EMITTER_ISSUER=http://worker:2025
# A2A_EMITTER_AUDIENCE=http://localhost:2024
# A2A_SUBAGENT_JWKS_URL=https://your-worker-host/.well-known/jwks.json

# ── Rate limiter (deferred — not yet integrated) ───────────────────────
# langstrata does not currently use the api_rate_limiter bite.
